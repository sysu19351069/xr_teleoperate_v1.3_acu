Robot AcuRobot
{
/*
 * A fictitious kinematic chain, without branches.
 * All the links are hollow cylinders infinitely thin (internal and external
 * radii are the same) with radius equal to 0.05 meters, unit length, unit mass.
 * They are connected by eight joints: revolute, revolute, revolute, revolute,
 * revolute, revolute, prismatic, revolute.
*/

RobotBase base0 {
    inertia_properties {
        mass = 1.0
        CoM = (0.0, 0.0, 0.0)
        Iy=0.0    Ix=0.0    Ixy=0.0    Iz=0.0    Ixz=0.0    Iyz=0.0
    }
    children {
        link1 via j1
    }
}

link link1 {
    id = 1
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link2 via j2
    }
    frames {
       link1_end {
           translation = (0.0, 0.0, -0.1)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}

link link2 {
    id = 2
    inertia_properties {
        mass = 1.0
        CoM = (0.0, 0.0, 0.5)
        Ix=0.33458  Iy=0.33458  Iz=0.0025  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link3 via j3
    }
    frames {
       link2_end {
           translation = (0.0, 0.0, 0.1)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}

link link3 {
    id = 3
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link4 via j4
    }
    frames {
       link3_end {
           translation = (0.0, 0.0, 0.1)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}

link link4 {
    id = 4
    inertia_properties {
        mass = 1.0
        CoM = (0.0, 0.0, 0.5)
        Ix=0.33458  Iy=0.33458  Iz=0.0025  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link5 via j5
    }
    frames {
       link4_end {
           translation = (0.0, 0.0, 0.1)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}

link link5 {
    id = 5
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    frames {
       link5_end {
           translation = (0.0, 0.0, 0.155)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}

link link6 {
    id = 6
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link7 via J7
    }
}

link link7 {
    id = 7
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link8 via J8
    }
}

link link8 {
    id = 8
    inertia_properties {
        mass = 1.0
        CoM = (0.5, .0, .0)
        Ix=0.0025  Iy=0.33458  Iz=0.33458  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {}
    frames {
       ee {
           translation = (0.0, 0.0, 0.35)
           rotation    = (0.0, 0.0, 0.0)
       }
    }
}



r_joint j1 {
    ref_frame {
        translation= (0.0, 0.0, 0.0)
        rotation   = (0.0, 0.0, 0.0)
    }
}

r_joint j2 {
    ref_frame {
        translation= (0.0, 0.0, 0.22)
        rotation   = (PI/2.0, 0.0, 0.0)
    }
}

r_joint j3 {
    ref_frame {
        translation= (0.0, 0.38, 0.0)
        rotation   = (PI, 0.0, -PI/2.0)
    }
}

r_joint j4 {
    ref_frame {
        translation= (0.0, 0.0, 0.0)
        rotation   = (0.0, PI/2.0, PI/2.0)
    }
}

r_joint j5 {
    ref_frame {
        translation= (0.0, 0.0, 0.42)
        rotation   = (-PI/2.0, 0.0, 0.0)
    }
}

r_joint j6 {
    ref_frame {
        translation= (0.0, 0.0, 0.0)
        rotation   = (PI/2.0, 0.0, 0.0)
    }
}

p_joint j7 {
    ref_frame {
        translation= (0.0, 0.0, 0.2)
        rotation   = (0.0, 0.0, 0.0)
    }
}

r_joint j8 {
    ref_frame {
        translation= (0.0, -0.08, 0.0)
        rotation   = (0.0, 0.0, 0.0)
    }
}

}
